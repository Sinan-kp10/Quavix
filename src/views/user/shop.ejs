<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="mobile-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="/" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="/products"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="order-history.html"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="wishlist.html"><i class="fa-regular fa-heart"></i> Wishlist</a>
                    <a href="cart.html"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
                    <% if (user) { %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <% } else { %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>
                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="/">Home</a>
                <a href="/products" class="text-primary">Shop</a>
                <a href="order-history.html">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <div class="nav-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>

                <a href="wishlist.html" class="relative">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                </a>
                <a href="cart.html" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>
                </a>
                <% if (user) { %>
                    <a href="/profile" class="nav-profile-icon">

                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" 
                                alt="Profile"
                                class="nav-profile-img">
                        <% } else { %>
                            <div class="nav-default-avatar">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                <% } %>

            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <header class="hero-section">
        <div class="container">
            <h1 class="text-white mb-2">Tech Collection</h1>
            <p class="text-light-white text-lg">Latest gadgets and accessories.</p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container shop-layout">

        <!-- Filter Overlay -->
        <div class="filter-overlay"></div>

        <!-- Mobile Filter Toggle Button -->
        <button class="btn-filter-toggle" id="filterToggle">
            <i class="fa-solid fa-filter"></i> Filters
        </button>

        <!-- Sidebar Filters -->
        <aside id="filterSidebar" class="filter-sidebar">
            <div class="card filter-card">
                <div class="filter-header">
                    <h3 class="filter-header-title">Filters</h3>
                    <button class="filter-close-btn" id="filterClose">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="mb-8">
                    <h4 class="mb-4 text-main filter-category-title">Categories</h4>
                    <ul class="filter-list">

                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="checkbox"
                                    class="checkbox-primary"> Mobiles</label></li>
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="checkbox"
                                    class="checkbox-primary"> Smart Watches</label></li>
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="checkbox"
                                    class="checkbox-primary"> Audio</label></li>

                    </ul>
                </div>

                <div class="mb-8">
                    <h4 class="mb-4 text-main filter-category-title">Sort By</h4>
                    <ul class="filter-list">
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="radio" name="sort"
                                    class="radio-primary"> Price: Low to High</label></li>
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="radio" name="sort"
                                    class="radio-primary"> Price: High to Low</label></li>
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="radio" name="sort"
                                    class="radio-primary"> Name: A to Z</label></li>
                        <li><label class="items-center flex gap-2 cursor-pointer"><input type="radio" name="sort"
                                    class="radio-primary"> Name: Z to A</label></li>
                    </ul>
                </div>





                <button class="btn btn-outline w-full rounded btn-filter-apply">Apply
                    Filters</button>
            </div>
        </aside>

        <!-- Product Grid -->
        <main>

            <div class="product-grid">
                <!-- Product Card: iPhone 13 -->
                <div class="product-card-horizontal">
                    <!-- Left: Image -->
                    <div class="product-card-img-container">
                        <a href="iphone-13.html" class="product-card-link">
                            <img src="images/iphone 13.jpg" alt="iPhone 13" class="product-card-img">
                        </a>
                        <button class="wishlist-btn-abs">
                            <i class="fa-regular fa-heart" style="color: #cbd5e1;"></i>
                        </button>
                    </div>

                    <!-- Right: Content -->
                    <div class="product-card-content">
                        <div class="product-info-main">
                            <h3 class="product-title-card">Apple iPhone 13 (Blue, 128 GB)</h3>
                            <span class="rating-badge rating-mobile ms-1">4.6 <i class="fa-solid fa-star"></i></span>

                            <ul class="product-highlights">
                                <li>128 GB ROM</li>
                                <li>15.49 cm (6.1 inch) Super Retina XDR Display</li>
                                <li>12MP + 12MP | 12MP Front Camera</li>
                                <li>A15 Bionic Chip Processor</li>
                            </ul>
                        </div>

                        <div class="product-info-price">
                            <div class="product-price-row">
                                <span class="price-lg">₹49,900</span>
                                <span class="rating-badge ms-2">4.6 <i class="fa-solid fa-star"></i></span>
                            </div>

                            <div class="product-price-discount-row">
                                <span class="price-old">₹59,900</span>
                                <span class="discount-text">17% off</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Card: Samsung S24 Ultra -->
                <div class="product-card-horizontal">
                    <!-- Left: Image -->
                    <div class="product-card-img-container">
                        <a href="product-details.html" class="product-card-link">
                            <img src="images/samsung-s24-ultra.png" alt="Samsung Galaxy S24 Ultra"
                                class="product-card-img">
                        </a>
                        <button class="wishlist-btn-abs">
                            <i class="fa-regular fa-heart" style="color: #cbd5e1;"></i>
                        </button>
                    </div>

                    <!-- Right: Content -->
                    <div class="product-card-content">
                        <div class="product-info-main">
                            <h3 class="product-title-card">Samsung Galaxy S24 Ultra (Titanium Gray, 256 GB)</h3>
                            <span class="rating-badge rating-mobile ms-1">4.8 <i class="fa-solid fa-star"></i></span>

                            <ul class="product-highlights">
                                <li>12 GB RAM | 256 GB ROM</li>
                                <li>17.25 cm (6.8 inch) QHD+ Dynamic AMOLED 2X Display</li>
                                <li>200MP + 50MP + 12MP + 10MP | 12MP Front Camera</li>
                                <li>Snapdragon 8 Gen 3 Processor</li>
                            </ul>
                        </div>

                        <div class="product-info-price">
                            <div class="product-price-row">
                                <span class="price-lg">₹1,29,999</span>
                                <span class="rating-badge ms-2">4.8 <i class="fa-solid fa-star"></i></span>
                            </div>

                            <div class="product-price-discount-row">
                                <span class="price-old">₹1,34,999</span>
                                <span class="discount-text">4% off</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Card: Apple Watch Ultra 2 -->
                <div class="product-card-horizontal">
                    <!-- Left: Image -->
                    <div class="product-card-img-container">
                        <a href="product-details.html" class="product-card-link">
                            <img src="images/smartwatch.png" alt="Apple Watch Ultra 2" class="product-card-img">
                        </a>
                        <button class="wishlist-btn-abs">
                            <i class="fa-regular fa-heart" style="color: #cbd5e1;"></i>
                        </button>
                    </div>

                    <!-- Right: Content -->
                    <div class="product-card-content">
                        <div class="product-info-main">
                            <h3 class="product-title-card">Apple Watch Ultra 2 (Titanium, Orange Ocean Band)</h3>
                            <span class="rating-badge rating-mobile ms-1">4.9 <i class="fa-solid fa-star"></i></span>

                            <ul class="product-highlights">
                                <li>49mm Titanium Case</li>
                                <li>Precision dual-frequency GPS</li>
                                <li>Up to 36 hours battery life</li>
                                <li>100m Water Resistance</li>
                            </ul>
                        </div>

                        <div class="product-info-price">
                            <div class="product-price-row">
                                <span class="price-lg">₹89,900</span>
                                <span class="rating-badge ms-2">4.9 <i class="fa-solid fa-star"></i></span>
                            </div>

                            <div class="product-price-discount-row">
                                <span class="price-old">₹99,900</span>
                                <span class="discount-text">10% off</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Card 1: Audio -->
                <div class="product-card-horizontal">
                    <!-- Left: Image -->
                    <div class="product-card-img-container">
                        <a href="product-details.html" class="product-card-link">
                            <img src="images/Audio.avif" alt="Sony WH-1000XM5" class="product-card-img">
                        </a>
                        <button class="wishlist-btn-abs">
                            <i class="fa-regular fa-heart" style="color: #cbd5e1;"></i>
                        </button>
                    </div>

                    <!-- Right: Content -->
                    <div class="product-card-content">
                        <div class="product-info-main">
                            <h3 class="product-title-card">Sony WH-1000XM5 Wireless Headphones</h3>
                            <span class="rating-badge rating-mobile ms-1">4.7 <i class="fa-solid fa-star"></i></span>

                            <ul class="product-highlights">
                                <li>Industry-leading Noise Cancellation</li>
                                <li>30 hours battery life with quick charging</li>
                                <li>Crystal clear hands-free calling</li>
                                <li>Ultra-comfortable, lightweight design</li>
                            </ul>
                        </div>

                        <div class="product-info-price">
                            <div class="product-price-row">
                                <span class="price-lg">₹24,990</span>
                                <span class="rating-badge ms-2">4.7 <i class="fa-solid fa-star"></i></span>
                            </div>

                            <div class="product-price-discount-row">
                                <span class="price-old">₹29,990</span>
                                <span class="discount-text">17% off</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Pagination -->
            <div class="pagination-container"
                style="justify-content: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #e2e8f0;">
                <div class="pagination-controls">
                    <button class="btn-page">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="btn-page active">1</button>
                    <button class="btn-page">2</button>
                    <button class="btn-page">3</button>
                    <button class="btn-page">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

        </main>
    </div>

    </div>
    <script src="/js/user/navbar.js"></script>
    
    <script>
        
        document.addEventListener('DOMContentLoaded', () => {
            const filterToggleBtn = document.getElementById('filterToggle');
            const filterSidebar = document.getElementById('filterSidebar');
            const filterCloseBtn = document.getElementById('filterClose');
            const filterOverlay = document.querySelector('.filter-overlay');

            if (filterToggleBtn && filterSidebar && filterOverlay && filterCloseBtn) {

                const openFilters = () => {
                    filterSidebar.classList.add('active');
                    filterOverlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                };

                const closeFilters = () => {
                    filterSidebar.classList.remove('active');
                    filterOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                };

                filterToggleBtn.addEventListener('click', openFilters);
                filterCloseBtn.addEventListener('click', closeFilters);
                filterOverlay.addEventListener('click', closeFilters);
            }
        });
    </script>
</body>

