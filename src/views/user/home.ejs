
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-fixed">
        <div class="container nav-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="mobile-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="/" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="products.html"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="order-history.html"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="wishlist.html"><i class="fa-regular fa-heart"></i> Wishlist</a>
                    <a href="cart.html"><i class="fa-solid fa-cart-shopping"></i> Cart</a>

                    <% if (user) { %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <% } else { %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>



                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="index.html" class="text-primary">Home</a>
                <a href="products.html">Shop</a>
                <a href="order-history.html">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <div class="nav-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>

                <a href="wishlist.html" class="relative">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                </a>

                <a href="cart.html" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>
                </a>

                <% if (user) { %>
                        <a href="/profile" class="nav-profile-icon">
                            <%= user.email.charAt(0).toUpperCase() %>
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-right-to-bracket"></i> Sign In
                        </a>
                <% } %>




            </div>
        </div>
    </nav>


    <!-- Vibrant Hero Section -->
    <header class="hero-large relative overflow-hidden">
        <!-- Hero Background Image -->
        <img src="images/banner.png" alt="Hero Banner" class="absolute inset-0 w-full h-full object-cover z-0">
        <div class="absolute inset-0 bg-black/60 z-0"></div>

        <div class="container relative z-10">
            <br>


            <h1 class="hero-title">

                <span class="text-gradient-hero">Experience the <br>Next Gen Electronics.</span>
            </h1>

            <p class="hero-text">
                Upgrade your life with cutting-edge gadgets and immersive audio gear.
            </p>

            <div class="flex gap-4 justify-center">
                <a href="products.html" class="btn btn-hero">
                    Shop Gadgets
                </a>
                <a href="" class="btn btn-hero-outline">
                    View Deals
                </a>
            </div>
        </div>
    </header>



    <!-- Trending Categories -->
    <section class="container section-padding">
        <div class="filter-header border-0 mb-4 p-0">
            <h2>Shop by Department</h2>
            <a href="products.html" class="text-primary font-bold">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="grid gap-6 category-grid-cards">

            <!-- Cat 2 -->
            <div class="category-card-lg">
                <div class="overlay-gradient">
                </div>
                <img src="images/Mobiles.png" alt="Mobiles" class="w-full h-full object-cover">
                <div class="category-content-abs">
                    <h3 class="text-white text-2xl">Mobiles</h3>

                </div>
            </div>
            <!-- Cat 3 -->
            <div class="category-card-lg">
                <div class="overlay-gradient">
                </div>
                <img src="images/audio.avif" alt="Audio" class="w-full h-full object-cover">
                <div class="category-content-abs">
                    <h3 class="text-white text-2xl">Audio</h3>

                </div>
            </div>
            <!-- Cat 4 -->
            <div class="category-card-lg">
                <div class="overlay-gradient">
                </div>
                <img src="images/smartwatch.png" alt="Smart Watches" class="w-full h-full object-cover">
                <div class="category-content-abs">
                    <h3 class="text-white text-2xl">Smart Watches</h3>
                </div>
            </div>
        </div>
    </section>

    <!-- Trending Products -->
    <section id="trending" class="section-padding">
        <div class="container">
            <h2 class="text-center mb-12">Products</h2>
            <br>

            <div class="product-grid">



                <!-- Product 2 -->
                <div class="card p-4">
                    <div class="product-img-wrapper">
                        <img src="images/samsung-s24-ultra.png" alt="Samsung Galaxy S24 Ultra"
                            class="w-full h-full object-cover">
                        <button class="wishlist-remove-btn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div>
                        <div class="text-muted text-sm mb-1">Mobiles
                        </div>
                        <h4 class="product-title-card">Samsung Galaxy S24 Ultra</h4>
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="price-old">₹1,34,999</span>
                                <span class="price-new">₹1,29,999</span>
                            </div>
                            <button class="btn btn-primary btn-icon-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>


                <!-- Product 3 -->
                <div class="card p-4">
                    <div class="product-img-wrapper">
                        <img src="images/iphone 13.jpg" alt="Apple iPhone 13" class="w-full h-full object-cover">
                        <button class="wishlist-remove-btn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div>
                        <div class="text-muted text-sm mb-1">Mobiles</div>
                        <h4 class="product-title-card">Apple iPhone 13</h4>
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="price-old">₹59,900</span>
                                <span class="price-new">₹49,900</span>
                            </div>
                            <button class="btn btn-primary btn-icon-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Product 4 -->
                <div class="card p-4">
                    <div class="product-img-wrapper">
                        <img src="images/Audio.avif" alt="Sony WH-1000XM5" class="w-full h-full object-cover">
                        <button class="wishlist-remove-btn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div>
                        <div class="text-muted text-sm mb-1">Audio</div>
                        <h4 class="product-title-card">Sony WH-1000XM5</h4>
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="price-old">₹29,990</span>
                                <span class="price-new">₹24,990</span>
                            </div>
                            <button class="btn btn-primary btn-icon-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Product 5 -->
                <div class="card p-4">
                    <div class="product-img-wrapper">
                        <img src="images/smartwatch.png" alt="Apple Watch Ultra 2" class="w-full h-full object-cover">
                        <button class="wishlist-remove-btn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div>
                        <div class="text-muted text-sm mb-1">Smart Watches</div>
                        <h4 class="product-title-card">Apple Watch Ultra 2</h4>
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="price-old">₹99,900</span>
                                <span class="price-new">₹89,900</span>
                            </div>
                            <button class="btn btn-primary btn-icon-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>



    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="grid footer-grid">
                <div>
                    <a href="index.html" class="logo mb-6 inline-block">
                        <i class="fa-solid fa-bolt text-primary"></i>
                        <span class="text-white">Quavix</span>
                    </a>
                    <br>
                    <p class="text-muted">Your premium destination for the <br> latest in technology.</p>
                </div>
                <div>
                    <h4 class="text-white mb-6">Shop</h4>
                    <ul class="text-muted leading-loose">

                        <li><a href="#">Phones</a></li>
                        <li><a href="#">Audio</a></li>
                        <li><a href="#">Smart Watches</a></li>

                    </ul>
                </div>
                <div>
                    <h4 class="mb-6">Contact Us</h4>
                    <ul class="text-muted leading-loose mb-6">
                        <li><a href="mailto:quavixsupport@gmail.com">quavixsupport@gmail.com</a></li>
                        <li><a href="tel:+918000090000">+91 80000 90000</a></li>
                        <li><a href="#">Bengaluru, India</a></li>
                    </ul>

                </div>
                <div>
                    <h4 class="mb-6">Follow Us</h4>
                    <div class="flex gap-4">
                        <a href="#" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" class="social-icon"><i class="fa-brands fa-facebook-f"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-copyright">
                &copy; 2026 Quavix. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="/js/user/navbar.js"></script>
    
</body>

