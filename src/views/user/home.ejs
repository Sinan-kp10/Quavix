
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-fixed">
        <div class="container nav-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="mobile-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="/" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="/products"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="order-history.html"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="wishlist.html"><i class="fa-regular fa-heart"></i> Wishlist</a>
                    <a href="cart.html"><i class="fa-solid fa-cart-shopping"></i> Cart</a>

                    <% if (user) { %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <% } else { %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>
                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="index.html" class="text-primary">Home</a>
                <a href="/products">Shop</a>
                <a href="order-history.html">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <div class="nav-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>

                <a href="wishlist.html" class="relative">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                </a>

                <a href="cart.html" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>
                </a>

                <% if (user) { %>
                    <a href="/profile" class="nav-profile-icon">

                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" 
                                alt="Profile"
                                class="nav-profile-img">
                        <% } else { %>
                            <div class="nav-default-avatar">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                <% } %>
            </div>
        </div>
    </nav>


    <!-- Vibrant Hero Section -->
    <header class="hero-large relative overflow-hidden">
        <!-- Hero Background Image -->
        <img src="images/banner.png" alt="Hero Banner" class="absolute inset-0 w-full h-full object-cover z-0">
        <div class="absolute inset-0 bg-black/60 z-0"></div>

        <div class="container relative z-10">
            <br>


            <h1 class="hero-title">

                <span class="text-gradient-hero">Experience the <br>Next Gen Electronics.</span>
            </h1>

            <p class="hero-text">
                Upgrade your life with cutting-edge gadgets and immersive audio gear.
            </p>

            <div class="flex gap-4 justify-center">
                <a href="products.html" class="btn btn-hero">
                    Shop Gadgets
                </a>
                <a href="" class="btn btn-hero-outline">
                    View Deals
                </a>
            </div>
        </div>
    </header>



    <!-- Trending Categories -->
    <!-- Shop by Department -->
    <section class="container section-padding overflow-hidden">
        <div class="filter-header border-0 mb-4 p-0">
            <h2>Shop by Department</h2>
        </div>

        <div class="category-marquee">
            <div class="category-marquee-inner">

                <% if (categories && categories.length > 0) { %>

                    <% categories.forEach(category => { %>
                        <div class="category-card-lg">
                            <div class="overlay-gradient"></div>
                            <img src="<%= category.categoryImage %>" 
                                alt="<%= category.name %>" 
                                class="w-full h-full object-cover">
                            <div class="category-content-abs">
                                <h3 class="text-white text-2xl">
                                    <%= category.name %>
                                </h3>
                            </div>
                        </div>
                    <% }) %>

                    <% categories.forEach(category => { %>
                        <div class="category-card-lg">
                            <div class="overlay-gradient"></div>
                            <img src="<%= category.categoryImage %>" 
                                alt="<%= category.name %>" 
                                class="w-full h-full object-cover">
                            <div class="category-content-abs">
                                <h3 class="text-white text-2xl">
                                    <%= category.name %>
                                </h3>
                            </div>
                        </div>
                    <% }) %>

                <% } %>

            </div>
        </div>
    </section>

    <!-- Trending Products -->
    <section class="container section-padding">
        <h2 class="text-center mb-8">Products</h2>
        <div class="home-product-grid">
            <!-- Card 1: Samsung S24 -->
            <div class="home-product-card">
                <div class="home-card-img-box">
                    <span class="home-card-offer">15% OFF</span>
                    <button class="wishlist-btn-sm"><i class="fa-regular fa-heart"></i></button>
                    <a href="product-details.html">
                        <img src="images/samsung-s24-ultra.png" alt="Samsung Galaxy S24 Ultra">
                    </a>
                </div>
                <div class="home-card-content">
                    <div class="card-cat-rating">
                        <span class="product-cat-sm">Mobiles</span>
                        <span class="home-card-rating">4.8 <i class="fa-solid fa-star"></i></span>
                    </div>
                    <h3 class="home-card-title">Samsung Galaxy S24 Ultra (Titanium Gray, 256 GB)</h3>
                    <ul class="home-card-highlights">
                        <li>12 GB RAM | 256 GB ROM</li>
                        <li>17.25 cm (6.8 inch) QHD+ Display</li>
                        <li>200MP + 50MP + 12MP + 10MP Camera</li>
                        <li>Snapdragon 8 Gen 3 Processor</li>
                    </ul>
                    <div class="home-card-bottom">
                        <div class="price-box">
                            <span class="price-old-sm">₹1,34,999</span>
                            <span class="price-new-sm">₹1,29,999</span>
                        </div>
                        <button class="btn-add-icon"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <!-- Card 2: iPhone 13 -->
            <div class="home-product-card">
                <div class="home-card-img-box">
                    <span class="home-card-offer">20% OFF</span>
                    <button class="wishlist-btn-sm"><i class="fa-regular fa-heart"></i></button>
                    <a href="iphone-13.html">
                        <img src="images/iphone 13.jpg" alt="iPhone 13">
                    </a>
                </div>
                <div class="home-card-content">
                    <div class="card-cat-rating">
                        <span class="product-cat-sm">Mobiles</span>
                        <span class="home-card-rating">4.6 <i class="fa-solid fa-star"></i></span>
                    </div>
                    <h3 class="home-card-title">Apple iPhone 13 (Blue, 128 GB)</h3>
                    <ul class="home-card-highlights">
                        <li>128 GB ROM</li>
                        <li>15.49 cm (6.1 inch) Super Retina XDR Display</li>
                        <li>12MP + 12MP | 12MP Front Camera</li>
                        <li>A15 Bionic Chip Processor</li>
                    </ul>
                    <div class="home-card-bottom">
                        <div class="price-box">
                            <span class="price-old-sm">₹59,900</span>
                            <span class="price-new-sm">₹49,900</span>
                        </div>
                        <button class="btn-add-icon"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <!-- Card 3: Sony Headphones -->
            <div class="home-product-card">
                <div class="home-card-img-box">
                    <span class="home-card-offer">17% OFF</span>
                    <button class="wishlist-btn-sm"><i class="fa-regular fa-heart"></i></button>
                    <a href="product-details.html">
                        <img src="images/Audio.avif" alt="Sony WH-1000XM5">
                    </a>
                </div>
                <div class="home-card-content">
                    <div class="card-cat-rating">
                        <span class="product-cat-sm">Audio</span>
                        <span class="home-card-rating">4.7 <i class="fa-solid fa-star"></i></span>
                    </div>
                    <h3 class="home-card-title">Sony WH-1000XM5 Wireless Headphones</h3>
                    <ul class="home-card-highlights">
                        <li>Industry-leading Noise Cancellation</li>
                        <li>30 hours battery life with quick charging</li>
                        <li>Crystal clear hands-free calling</li>
                        <li>Ultra-comfortable design</li>
                    </ul>
                    <div class="home-card-bottom">
                        <div class="price-box">
                            <span class="price-old-sm">₹29,990</span>
                            <span class="price-new-sm">₹24,990</span>
                        </div>
                        <button class="btn-add-icon"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <!-- Card 4: Apple Watch -->
            <div class="home-product-card">
                <div class="home-card-img-box">
                    <span class="home-card-offer">10% OFF</span>
                    <button class="wishlist-btn-sm"><i class="fa-regular fa-heart"></i></button>
                    <a href="product-details.html">
                        <img src="images/smartwatch.png" alt="Apple Watch Ultra 2">
                    </a>
                </div>
                <div class="home-card-content">
                    <div class="card-cat-rating">
                        <span class="product-cat-sm">Smart Watches</span>
                        <span class="home-card-rating">4.9 <i class="fa-solid fa-star"></i></span>
                    </div>
                    <h3 class="home-card-title">Apple Watch Ultra 2 (Titanium, Orange Ocean Band)</h3>
                    <ul class="home-card-highlights">
                        <li>49mm Titanium Case</li>
                        <li>Precision dual-frequency GPS</li>
                        <li>Up to 36 hours battery life</li>
                        <li>100m Water Resistance</li>
                    </ul>
                    <div class="home-card-bottom">
                        <div class="price-box">
                            <span class="price-old-sm">₹99,900</span>
                            <span class="price-new-sm">₹89,900</span>
                        </div>
                        <button class="btn-add-icon"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
            </div>

        </div>
    </section>



    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="grid footer-grid">
                <div>
                    <a href="index.html" class="logo mb-6 inline-block">
                        <i class="fa-solid fa-bolt text-primary"></i>
                        <span class="text-white">Quavix</span>
                    </a>
                    <br>
                    <p class="text-muted">Your premium destination for the <br> latest in technology.</p>
                </div>
                <div>
                    <h4 class="text-white mb-6">Shop</h4>
                    <ul class="text-muted leading-loose">

                        <li><a href="#">Phones</a></li>
                        <li><a href="#">Audio</a></li>
                        <li><a href="#">Smart Watches</a></li>

                    </ul>
                </div>
                <div>
                    <h4 class="mb-6">Contact Us</h4>
                    <ul class="text-muted leading-loose mb-6">
                        <li><a href="mailto:quavixsupport@gmail.com">quavixsupport@gmail.com</a></li>
                        <li><a href="tel:+918000090000">+91 80000 90000</a></li>
                        <li><a href="#">Bengaluru, India</a></li>
                    </ul>

                </div>
                <div>
                    <h4 class="mb-6">Follow Us</h4>
                    <div class="flex gap-4">
                        <a target="_blank"  href="https://www.instagram.com/sin4n_x4?igsh=MWlvYzhzMTZsenl6aw%3D%3D&utm_source=qr" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
                        <a target="_blank"  href="https://www.linkedin.com/in/muhammed-sinan-kp-853057383/" class="social-icon"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a target="_blank" href="#" class="social-icon"><i class="fa-brands fa-facebook-f"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-copyright">
                &copy; 2026 Quavix. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="/js/user/navbar.js"></script>
    
</body>

