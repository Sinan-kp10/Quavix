<body>
    <% if (typeof toastMessage !== "undefined") { %>
        <div id="toast" class="toast <%= toastType %>">
            <%= toastMessage %>
        </div>
    <% } %>

    <!-- Navbar -->
    <nav class="navbar navbar-fixed">
        <div class="container nav-container">
            <a href="index.html" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="mobile-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="index.html" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="products.html"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="order-history.html"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="wishlist.html"><i class="fa-regular fa-heart"></i> Wishlist</a>
                    <a href="cart.html"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
                    <% if(user){ %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <%} else{ %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>

                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="/">Home</a>
                <a href="products.html">Shop</a>
                <a href="order-history.html">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <div class="nav-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>

                <a href="wishlist.html" class="relative">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                </a>

                <a href="cart.html" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>
                </a>

                <% if (user) { %>
                        <a href="/profile" class="nav-profile-icon">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </a>
                <% } else { %>
                        <a href="/login" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-right-to-bracket"></i> Sign In
                        </a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Profile Section -->
    <section class="section-padding section-profile">
        <div class="container">
            <h2 class="mb-8">My Profile</h2>

            <div class="grid gap-8 profile-grid">
                <!-- Profile Sidebar / Card -->
                <div class="card p-6">
                    <div class="text-center mb-6">
                        <div class="profile-img-container text-primary text-3xl font-bold">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>

                        <h3 class="text-xl font-bold"><%= user.name %></h3>
                        <p class="text-muted"><%= user.email %></p>
                    </div>
                    <br>
                    <div class="flex flex-col">
                        <a href="order-history.html" class="profile-nav-link">
                            <i class="fa-solid fa-box"></i> My Orders
                        </a>
                        <a href="cart.html" class="profile-nav-link">
                            <i class="fa-solid fa-cart-shopping"></i> My Cart
                        </a>
                        <a href="wishlist.html" class="profile-nav-link">
                            <i class="fa-regular fa-heart"></i> My Wishlist
                        </a>
                        <a href="coupons.html" class="profile-nav-link">
                            <i class="fa-solid fa-ticket"></i> My Coupons
                        </a>
                        <a href="wallet.html" class="profile-nav-link">
                            <i class="fa-solid fa-wallet"></i> My Wallet
                        </a>
                        <a href="referral.html" class="profile-nav-link">
                            <i class="fa-solid fa-share-nodes"></i> Refer & Earn
                        </a>
                        <a href="/logout" class="btn btn-outline-danger w-full mt-4 text-left">
                            <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
                        </a>
                    </div>
                </div>

                <!-- Profile Details Form -->
                <div class="flex flex-col gap-8">

                    <!-- Personal Details & Addresses -->
                    <div class="card p-8">
                        <h3 class="text-xl font-bold mb-6">Personal Details</h3>
                        <form id="profileUpdateForm" method="post" action="/updateProfile">
                            <div class="form-group mb-4">
                                <label class="form-label">Full Name</label>
                                <input type="text" id="name" name="name" class="form-input" value="<%= user.name %>" >
                            </div>
                            <small class="error-message"></small>


                            <div class="form-group mb-4">
                                <label class="form-label">Current password</label>
                                <div class="password-group">
                                    <input type="password"  name="currentPassword" id="currentPassword" class="form-input" placeholder="Enter current password">
                                    <button type="button" class="password-toggle" data-target="currentPassword">
                                        <i class="fa-regular fa-eye-slash"></i>
                                    </button>

                                </div>
                                <small class="error-message"></small>

                            </div>

                            <div class="form-group">
                                <label class="form-label">New Password</label>
                                <div class="password-group">
                                <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Enter your password">
                                <button type="button" class="password-toggle" data-target="newPassword">
                                    <i class="fa-regular fa-eye-slash"></i>
                                </button>
                            </div>
                                <small class="error-message"></small>
                            </div>
                            <br>

                            <div class="flex justify-end">
                                <button type="submit" class="btn btn-primary update-email-btn">Save Profile</button>
                            </div>
                        </form>

                        <form id="emailForm" method="post" action="/verifyEmailResetOtp">
                            <div class="form-group mb-6">
                                <label class="form-label">Email</label>

                                <div class="email-update-group">
                                    <input  type="email" id="newEmail" name="newEmail" class="form-input" value="<%= user.email %>">
                                    <button  type="submit" class="btn btn-primary update-email-btn">
                                        Update Email
                                    </button>
                                </div>
                               <small class="error-message" id="passwordError"></small>

                            </div>

                        </form>

                        <div class="flex justify-between items-center mb-6 mt-10">
                            <h3 class="text-xl font-bold">Saved Addresses</h3>
                        </div>


                       <% if (user.address && user.address.length > 0) { %>

                            <% user.address.forEach(function(addr){ %>

                                <div class="address-card">
                                    <h4 class="font-bold mb-1">
                                        <%= addr.fullname %> (<%= addr.addressType %>)
                                    </h4>

                                    <p class="text-muted text-sm leading-relaxed mb-2">
                                        <%= addr.street %>, <br>
                                        <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %> <br>
                                        India
                                    </p>

                                    <p class="text-sm font-medium mb-3">
                                        Phone: +91 <%= addr.phone %>
                                    </p>

                                    <div class="flex gap-4 justify-end">
                                        <button class="btn btn-outline btn-sm">Edit</button>
                                        <button class="btn btn-outline-danger btn-sm">Remove</button>
                                    </div>
                                </div>

                            <% }) %>

                        <% } else { %>

                            <p class="text-muted">No addresses added yet.</p>

                        <% } %>
                        <br>
                        <div class="mb-8">
                            <a href="/addAddress" class="btn btn-sm btn-primary"><i
                                class="fa-solid fa-plus mr-2"></i>
                                Add New Address</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/user/navbar.js"></script>
    <script src="/js/user/profile.js"></script>



    
</body>

