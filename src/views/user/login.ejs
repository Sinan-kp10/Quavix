
<body class="auth-body">
    <% if (typeof toastMessage !== "undefined") { %>
        <div id="toast" class="toast <%= toastType %>">
            <%= toastMessage %>
        </div>
    <% } %>



    <!-- Dark overlay for background image readability -->
    <div class="auth-overlay">
    </div>

    <!-- Navbar (Transparent) -->
    <nav class="navbar auth-nav">
        <div class="container nav-container">
            <a href="/login" class="logo">
                <i class="fa-solid fa-bolt text-white"></i>
                <span class="text-white" style="-webkit-text-fill-color: white;">Quavix</span>
            </a>
            <div class="nav-menu">
                <a href="/" class="nav-link text-light-white">Back to Home</a>
            </div>
        </div>
    </nav>

    <!-- Login Section -->
    <div class="auth-container">
        <div class="card auth-card">
            <div class="text-center mb-4">
                <h2 class="mb-2">Welcome Back</h2>
                <p class="text-muted">Enter your credentials to access your account.</p>
            </div>
            

            <form id="loginForm" method="post" action="/login">
                

                <div class="form-group mb-5">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="email" class="form-input" name="email" placeholder="Enter your email address">
                    <small class="error-message" id="emailError">
                        
                    </small>
                </div>


                <div class="form-group auth-input-group">
                    <label class="form-label flex justify-between items-center">
                        Password
                        <a href="/forgotPassword" class="text-primary text-sm">Forgotten password?</a>
                    </label>
                    <div class="password-group">
                        <input type="password" id="password" name="password" class="form-input" placeholder="Enter your password">
                        <button type="button" id="togglePassword" class="password-toggle">
                            <i id="eyeIcon" class="fa-regular fa-eye-slash"></i>
                        </button>
                    </div>
                    <small class="error-message" id="passwordError"></small>

                </div>
                <button type="submit" class="btn btn-primary w-full text-1rem">Sign In</button>



                <div class="text-center text-muted auth-divider">OR</div>

                <button type="button" class="btn btn-outline w-full btn-google">
                    <i class="fa-brands fa-google"></i> Sign in with Google
                </button>
            </form>

            <div class="text-center mt-2">
                <p class="text-sm text-muted">
                    Don't have an account?
                    <a href="/register" class="text-primary font-bold">Sign up</a>
                </p>


            </div>
        </div>
    </div>

    <script src="/js/user/login.js"></script>

</body>

