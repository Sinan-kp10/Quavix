
<body class="auth-body">



    <!-- OTP Section -->
    <div class="auth-container">
        <div class="card auth-card text-center p-8 otp-card">

            <div class="mb-6">
                <a href="/loginVerify" class="logo justify-center mb-4">
                    <i class="fa-solid fa-bolt text-primary"></i>
                    <span class="text-primary">Quavix</span>
                </a>
                <h2 class="mb-2">Enter OTP</h2>
                <p class="text-muted text-sm">We have sent a OTP to your mobile number</p>
            </div>

            <form>
                <div class="otp-input-group">
                    <input type="text" class="form-input otp-digit" maxlength="1">
                    <div class="otp-dash">-</div>
                    <input type="text" class="form-input otp-digit" maxlength="1">
                    <div class="otp-dash">-</div>
                    <input type="text" class="form-input otp-digit" maxlength="1">
                    <div class="otp-dash">-</div>
                    <input type="text" class="form-input otp-digit" maxlength="1">
                </div>

                <button type="button" onclick="window.location.href='/newPassword'" class="btn btn-verify w-full mb-4">Verify</button>
            </form>

            <p class="text-sm text-muted">
                Didn't receive code? <a href="#" class="link-resend">Resend OTP</a>
            </p>
        </div>
    </div>

</body>

