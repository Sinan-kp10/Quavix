
<body class="auth-body">
    <% if (typeof toastMessage !== "undefined") { %>
    <div id="toast" class="toast <%= toastType %>">
         <%= toastMessage %>
    </div>
    <% } %>

    <!-- Dark overlay for background image readability -->
    <div class="auth-overlay">
    </div>


    <!-- Login Section -->
    <div class="auth-container">
        <div class="card auth-card">
            <div class="text-center mb-4">
                <h2 class="mb-2">Admin Login</h2>
                
            </div>


            <form id="adminLoginForm" method="post" action="/admin/login">


                <div class="form-group mb-5">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="email" class="form-input" name="email"
                        placeholder="Enter your email address">
                    <small class="error-message" ></small>
                </div>


                <div class="form-group auth-input-group">
                    <label class="form-label flex justify-between items-center">
                        Password
                    </label>
                    <div class="password-group relative">
                        <input type="password" id="password" name="password" class="form-input"
                            placeholder="Enter your password">
                        <button type="button" id="togglePassword" class="password-toggle">
                            <i id="eyeIcon" class="fa-regular fa-eye-slash"></i>
                        </button>
                        <small class="error-message" ></small>

                    </div>

                </div>
                
                <button type="submit" class="btn btn-primary w-full text-1rem mt-4">Sign In</button>

            </form>

            <p class="text-center text-muted text-sm mt-4">&copy; 2026 Quavix Admin System</p>

        </div>
    </div>
    <script src="/js/admin/login.js"></script>



</body>

