<body>
    <% if (typeof toastMessage !== "undefined") { %>
    <div id="toast" class="toast <%= toastType %>">
         <%= toastMessage %>
    </div>
    <% } %>

    <div class="admin-layout">
        <!-- Mobile Header -->
        <div class="mobile-header">
            <div class="mobile-logo">
                <i class="fa-solid fa-bolt"></i> Quavix
            </div>
            <button class="menu-toggle" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <!-- Sidebar Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo">
                <i class="fa-solid fa-bolt"></i> Quavix Admin
            </div>

            <nav>
                <a href="index.html" class="sidebar-link"><i class="fa-solid fa-chart-line"></i>
                    Dashboard</a>
                <a href="products.html" class="sidebar-link"><i class="fa-solid fa-box"></i>
                    Products</a>
                <a href="orders.html" class="sidebar-link"><i class="fa-solid fa-clipboard-list"></i> Orders</a>
                <a href="coupons.html" class="sidebar-link"><i class="fa-solid fa-ticket"></i> Coupons</a>
                <a href="categories.html" class="sidebar-link active"><i class="fa-solid fa-tags"></i>
                    Categories</a>
                <a href="users.html" class="sidebar-link"><i class="fa-solid fa-users"></i>
                    Users</a>
                <a href="banner.html" class="sidebar-link"><i class="fa-solid fa-image"></i>
                    Banner</a>

                <a href="reports.html" class="sidebar-link"><i class="fa-solid fa-chart-pie"></i>
                    Reports</a>

            </nav>

            <div class="sidebar-footer">
                <a href="../index.html" class="sidebar-link"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
        </aside>

        <!-- Category Content -->
        <main class="content">
            <header class="flex justify-between items-center mb-4">
                <h2>Category Management</h2>
                <button class="btn btn-primary" onclick="openModal('categoryModal')"><i class="fa-solid fa-plus"></i>
                    Add Category</button>
            </header>

            <div class="card p-4">
                <div class="flex justify-between items-center mb-4">
                    <div class="flex gap-2">
                        <div class="search-group">
                            <input type="text" class="form-input" placeholder="Search categories..."
                                style="width: 300px;">
                            <button class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </div>
                        <select class="form-select" style="width: 150px;">
                            <option>All Status</option>
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Products Count</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Smart Watches</td>
                                <td>65</td>
                                <td><span class="status-badge status-success">Active</span></td>
                                <td style="text-align: right;">
                                    <button class="btn btn-outline btn-sm" onclick="openModal('categoryModal')"><i
                                            class="fa-solid fa-pen"></i></button>
                                    <button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>Mobiles</td>
                                <td>85</td>
                                <td><span class="status-badge status-success">Active</span></td>
                                <td style="text-align: right;">
                                    <button class="btn btn-outline btn-sm" onclick="openModal('categoryModal')"><i
                                            class="fa-solid fa-pen"></i></button>
                                    <button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>Audio</td>
                                <td>45</td>
                                <td><span class="status-badge status-success">Active</span></td>
                                <td style="text-align: right;">
                                    <button class="btn btn-outline btn-sm" onclick="openModal('categoryModal')"><i
                                            class="fa-solid fa-pen"></i></button>
                                    <button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="pagination">
                    <a href="#" class="page-link"><i class="fa-solid fa-chevron-left"></i></a>
                    <a href="#" class="page-link active">1</a>
                    <a href="#" class="page-link">2</a>
                    <a href="#" class="page-link">3</a>
                    <a href="#" class="page-link"><i class="fa-solid fa-chevron-right"></i></a>
                </div>
            </div>
        </main>
    </div>

    <!-- Category Modal -->
    <div id="categoryModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Add / Edit Category</h3>
                <button class="btn btn-outline btn-sm" onclick="closeModal('categoryModal')"><i
                        class="fa-solid fa-xmark"></i></button>
            </div>
            <form>
                <div class="form-group">
                    <label>Category Name</label>
                    <input type="text" class="form-input" placeholder="e.g. Electronics">
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-select">
                        <option>Active</option>
                        <option>Inactive</option>
                    </select>
                    <div class="form-group">
                        <label>Category Image</label>
                        <div class="upload-area" onclick="document.getElementById('catImage').click()">
                            <input type="file" id="catImage" hidden>
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            <p>Click or Drop Image Here</p>
                            <small>Support: JPG, PNG, WEBP</small>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-primary w-full">Save Category</button>
            </form>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('active');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
        }
        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }
        window.onclick = function (event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('active');
            }
        }
    </script>

</body>

