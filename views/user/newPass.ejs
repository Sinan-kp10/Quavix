
<body class="auth-body">

    <!-- Dark overlay -->
    <div class="auth-overlay">
    </div>

    <!-- New Password Section -->
    <div class="auth-container">
        <div class="card auth-card text-center p-8 otp-card">

            <div class="mb-6">
                <a href="/newPassword" class="logo justify-center mb-4">
                    <i class="fa-solid fa-bolt text-primary"></i>
                    <span class="text-primary">Quavix</span>
                </a>
                <h2 class="mb-2">New Password</h2>
                <p class="text-muted text-sm">Email Verification Successfull</p>
            </div>

            <form id="newPasswordForm" method="post" action="/newPassword">
                <div class="form-group mb-6 text-left">
                    <label class="form-label">Password</label>
                    <div class="password-group">
                        <input type="password" id="password" name="password" class="form-input" placeholder="Enter new password" >
                        <button type="button" id="togglePassword" class="password-toggle">
                            <i id="eyeIcon" class="fa-regular fa-eye-slash"></i>
                        </button>
                    </div>
                    <small class="error-message" id="passwordError"></small>
                </div>

                <button type="submit" id="confirmBtn" class="btn btn-verify w-full mb-6 text-uppercase" disabled>Confirm</button>
            </form>

        </div>
    </div>
    <script src="/js/user/newpass.js"></script>

    
</body>

